# Copy to .env and fill in after `cdk deploy`. Never commit real values.

AWS_REGION=us-east-1
AWS_PROFILE=default

# Dual-tier cascading (Haiku = fast, Sonnet 5 = reasoning)
FAST_TIER_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
REASONING_TIER_MODEL_ID=anthropic.claude-sonnet-5
# Optional override for the reasoning tier (backward compatible)
BEDROCK_MODEL_ID=
ROUTER_MODE=hybrid
ROUTER_ESCALATE_ON_TOOLS=true
ROUTER_CONFIDENCE_FLOOR=0.62
FAST_TIER_MAX_TOKENS=1024

# Bedrock — enable Claude Sonnet 5 and Claude 3.5 Haiku in Model access
# In-region Sonnet: anthropic.claude-sonnet-5
# US geo profile: us.anthropic.claude-sonnet-5
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
THINKING_TYPE=adaptive
THINKING_EFFORT=medium
MAX_TOKENS=8192

# Populated from stack outputs after deploy
API_BASE_URL=
KNOWLEDGE_BASE_ID=
GUARDRAIL_IDENTIFIER=
GUARDRAIL_VERSION=DRAFT
DOCUMENTS_BUCKET=
UPLOADS_BUCKET=

# Optional overrides
LOG_LEVEL=INFO
POWERTOOLS_SERVICE_NAME=multimodal-agentic-architecture-aws
POWERTOOLS_METRICS_NAMESPACE=MultimodalAgenticArchitectureAws
MAX_TOOL_ITERATIONS=6
MONTHLY_BUDGET_USD=150
